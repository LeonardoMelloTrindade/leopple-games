{
  "name": "leopple-games",
  "private": true,
  "version": "0.0.0",
  "author": "Leonardo Trindade",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepare": "husky",
    "docker:dev": "turbo run docker:dev",
    "docker:dev:all": "docker compose -f docker-compose.dev.yml up",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml build",
    "docker:db": "docker compose -f docker-compose.dev.yml up postgresql redis",
    "docker:db:down": "docker compose -f docker-compose.dev.yml down postgresql redis"
  },
  "devDependencies": {
    "@changesets/cli": "2.30.0",
    "@commitlint/cli": "20.4.3",
    "@commitlint/config-conventional": "20.4.3",
    "husky": "9.1.7",
    "prettier": "3.5.3",
    "turbo": "2.8.12",
    "typescript": "5.9.2",
    "lint-staged": "^16.4.0"
  },
  "engines": {
    "node": "24.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.6.2",
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-musl": "4.59.0"
  },
  "lint-staged": {
    "*.{js,ts,vue,svelte,tsx}": "npm run lint-staged"
  }
}